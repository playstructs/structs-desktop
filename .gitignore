# Build artifacts (rebuilt by `make sync`)
frontend/css/
frontend/fonts/
frontend/img/
frontend/lottie/
frontend/structicons/
frontend/js/
frontend/js/workers/
# SUI behaviour modules, copied from the webapp submodule by sync.sh.
frontend/sui/
.build-tmp/

# Generated harnesses (scripts/make_harness.sh) — must never ship in
# frontendDist, which is the whole frontend/ directory. Globbed, not listed:
# the per-file list drifted every time a harness was added, and the newest two
# were tracked by accident.
frontend/_harness*
frontend/_fixtures*

# Rust build
src-tauri/target/

# Node
node_modules/

# Reference repos (cloned for local study only)
reference/

# Claude Code session data
.claude/*
# …except project skills, which are part of the repo: they tell every session
# how to build UI in this codebase, and a local-only copy helps nobody else.
!.claude/skills/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tauri generated schemas (rebuilt on build)
src-tauri/gen/

# MCP config contains bearer token — don't commit
# Users generate their own .mcp.json from the Debug tab
.mcp.json

# Icon source (keep generated sizes, not the 1024px source)
src-tauri/icons/Structs Icon.png
