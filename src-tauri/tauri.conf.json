{
  "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/master/tauri.schema.json",
  "productName": "Structs",
  "version": "0.1.1",
  "identifier": "app.structs.desktop",
  "build": {
    "beforeBuildCommand": "npm run build-frontend",
    "beforeDevCommand": "",
    "frontendDist": "../frontend"
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null,
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' tauri: ipc:; connect-src 'self' tauri: ipc: ws: wss: http: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-eval' 'unsafe-inline' 'unsafe-hashes'; worker-src 'self' blob:; img-src 'self' data: blob:"
    },
    "windows": []
  }
}
